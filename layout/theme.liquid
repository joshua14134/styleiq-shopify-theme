<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0B0C0E">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{% if page_title %}{{ page_title | escape }}{% else %}STYLEIQ{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:site_name" content="{{ shop.name | default: 'STYLEIQ' | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
  {% if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}
  {% if page_image %}<meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  {{ 'styleiq.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'styleiq.js' | asset_url }}" defer></script>
</head>
<body>
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="MainContent">{{ content_for_layout }}</main>
  {% section 'footer' %}
  <div class="siq-overlay" data-siq-overlay hidden></div>
  <aside class="siq-cart-drawer" data-siq-cart-drawer aria-hidden="true" aria-label="Shopping bag">
    <div class="siq-drawer-head"><div><span class="siq-kicker">THE GOOD STUFF</span><h2>Your bag <span data-siq-cart-count>({{ cart.item_count }})</span></h2></div><button type="button" class="siq-icon-button" data-siq-close aria-label="Close bag">×</button></div>
    <div class="siq-shipping"><div class="siq-shipping-copy" data-siq-shipping-copy>You're close to complimentary shipping.</div><div class="siq-progress"><span data-siq-shipping-progress></span></div></div>
    <div class="siq-cart-items" data-siq-cart-items><p class="siq-cart-loading">Preparing your edit…</p></div>
    <div class="siq-cart-upsell"><div class="siq-upsell-heading"><span class="siq-kicker">COMPLETE THE EDIT</span><a href="{{ routes.all_products_collection_url }}">Explore all ↗</a></div><div class="siq-upsell-list" data-siq-upsells></div></div>
    <div class="siq-cart-bottom"><div class="siq-cart-subtotal"><span>Subtotal</span><strong data-siq-cart-subtotal>{{ cart.total_price | money }}</strong></div><p>Shipping and discounts calculated at checkout.</p><a class="siq-checkout-button" href="{{ routes.cart_url }}" data-siq-checkout>Continue to checkout <span>→</span></a><a class="siq-continue" href="{{ routes.all_products_collection_url }}" data-siq-continue>Continue exploring</a></div>
  </aside>
  <div class="siq-quickview" data-siq-quickview aria-hidden="true" role="dialog" aria-modal="true" aria-label="Quick view"><button type="button" class="siq-quickview-close" data-siq-qv-close aria-label="Close quick view">×</button><div class="siq-qv-content" data-siq-qv-content></div></div>
</body>
</html>