
{% liquid
  assign featured_collection = section.settings.collection
  assign product_limit = section.settings.limit
  assign use_slider = section.settings.enable_slider
%}

<section
  id="StyleiqFeatured-{{ section.id }}"
  class="siq-featured-section"
  aria-label="{{ section.settings.heading | default: 'Featured collection' | escape }}"
>
  <div class="siq-featured-container">

    <!-- SECTION HEADER -->
    <div class="siq-featured-header">
      <div class="siq-featured-heading">

        {% if section.settings.eyebrow != blank %}
          <span class="siq-featured-eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <p>{{ section.settings.description | escape }}</p>
        {% endif %}

      </div>

      <div class="siq-featured-actions">

        {% if use_slider and featured_collection != blank and featured_collection.products_count > 4 %}
          <div class="siq-featured-arrows">
            <button
              type="button"
              class="siq-featured-arrow"
              data-featured-prev
              aria-label="Scroll products left"
              disabled
            >
              <span aria-hidden="true">←</span>
            </button>

            <button
              type="button"
              class="siq-featured-arrow"
              data-featured-next
              aria-label="Scroll products right"
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        {% endif %}

        {% if featured_collection != blank %}
          <a
            class="siq-featured-view-all"
            href="{{ featured_collection.url }}"
          >
            View collection <span aria-hidden="true">↗</span>
          </a>
        {% endif %}

      </div>
    </div>

    <!-- PRODUCTS -->
    {% if featured_collection != blank %}

      {% if featured_collection.products_count > 0 %}

        <div
          class="siq-featured-products{% if use_slider %} is-slider{% endif %}"
          {% if use_slider %}
            data-featured-track
            tabindex="0"
            role="region"
            aria-label="Featured products"
          {% endif %}
        >

          {% for product in featured_collection.products limit: product_limit %}
            <div class="siq-featured-product" {% if use_slider %}data-featured-card{% endif %}>
              {% render 'product-card', product: product %}
            </div>
          {% endfor %}

        </div>

      {% else %}

        <div class="siq-featured-empty">
          <span class="siq-featured-eyebrow">THE STYLEIQ EDIT</span>
          <h3>No products available yet.</h3>
          <p>Add products to this collection to display them here.</p>
        </div>

      {% endif %}

    {% else %}

      <div class="siq-featured-empty">
        <span class="siq-featured-eyebrow">CURATE YOUR COLLECTION</span>
        <h3>Your next edit starts here.</h3>
        <p>
          Select a collection in the Shopify theme editor
          to display your featured products.
        </p>
      </div>

    {% endif %}

  </div>
</section>

{% style %}
  #StyleiqFeatured-{{ section.id }} {
    --siq-bg: {{ section.settings.background_color }};
    --siq-text: #171714;
    --siq-muted: #706b63;
    --siq-gold: #b89449;
    --siq-border: #e5dfd4;
    --siq-card-bg: #fffefa;

    width: 100%;
    overflow: hidden;
    background: var(--siq-bg);
    color: var(--siq-text);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #StyleiqFeatured-{{ section.id }} *,
  #StyleiqFeatured-{{ section.id }} *::before,
  #StyleiqFeatured-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-container {
    width: calc(100% - 48px);
    max-width: 1440px;
    margin-inline: auto;
  }

  /* SECTION HEADER */

  #StyleiqFeatured-{{ section.id }} .siq-featured-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 36px;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-heading {
    min-width: 0;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-eyebrow {
    display: inline-block;
    margin-bottom: 15px;
    color: var(--siq-gold);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .22em;
    line-height: 1.7;
    text-transform: uppercase;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-heading h2 {
    margin: 0;
    color: var(--siq-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -.045em;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-heading p {
    max-width: 580px;
    margin: 17px 0 0;
    color: var(--siq-muted);
    font-size: 14px;
    line-height: 1.8;
  }

  /* HEADER ACTIONS */

  #StyleiqFeatured-{{ section.id }} .siq-featured-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
    flex-shrink: 0;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-view-all {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--siq-gold);
    color: var(--siq-text);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .09em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition: color .2s ease, border-color .2s ease;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-view-all:hover {
    color: var(--siq-gold);
    border-color: var(--siq-text);
  }

  /* SLIDER ARROWS */

  #StyleiqFeatured-{{ section.id }} .siq-featured-arrows {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--siq-border);
    border-radius: 50%;
    background: transparent;
    color: var(--siq-text);
    font-family: inherit;
    font-size: 20px;
    cursor: pointer;
    transition:
      background .25s ease,
      border-color .25s ease,
      color .25s ease;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-arrow:hover:not(:disabled) {
    background: var(--siq-text);
    border-color: var(--siq-text);
    color: #fff;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-arrow:disabled {
    opacity: .35;
    cursor: not-allowed;
  }

  /* PRODUCT GRID */

  #StyleiqFeatured-{{ section.id }} .siq-featured-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
    gap: 30px 22px;
    min-width: 0;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-product {
    width: 100%;
    min-width: 0;
    height: 100%;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-product > * {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-product img {
    max-width: 100%;
  }

  /* HORIZONTAL SLIDER */

  #StyleiqFeatured-{{ section.id }} .siq-featured-products.is-slider {
    display: flex;
    align-items: stretch;
    gap: 22px;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 8px;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-products.is-slider::-webkit-scrollbar {
    display: none;
  }

  #StyleiqFeatured-{{ section.id }} .is-slider .siq-featured-product {
    flex: 0 0 calc((100% - 66px) / 4);
    scroll-snap-align: start;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-products:focus-visible {
    outline: 2px solid var(--siq-gold);
    outline-offset: 4px;
  }

  /* EMPTY STATE */

  #StyleiqFeatured-{{ section.id }} .siq-featured-empty {
    padding: 75px 25px;
    border: 1px solid var(--siq-border);
    background: var(--siq-card-bg);
    text-align: center;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-empty h3 {
    margin: 0 0 15px;
    color: var(--siq-text);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(27px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.2;
  }

  #StyleiqFeatured-{{ section.id }} .siq-featured-empty p {
    margin: 0;
    color: var(--siq-muted);
    font-size: 13px;
    line-height: 1.8;
  }

  /* TABLET */

  @media (max-width: 1100px) {
    #StyleiqFeatured-{{ section.id }} .siq-featured-products:not(.is-slider) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px 18px;
    }

    #StyleiqFeatured-{{ section.id }} .is-slider .siq-featured-product {
      flex-basis: calc((100% - 36px) / 3);
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-header {
      gap: 22px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-actions {
      gap: 16px;
    }
  }

  @media (max-width: 850px) {
    #StyleiqFeatured-{{ section.id }} .siq-featured-products:not(.is-slider) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #StyleiqFeatured-{{ section.id }} .is-slider .siq-featured-product {
      flex-basis: calc((100% - 18px) / 2);
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-actions {
      width: 100%;
      justify-content: space-between;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    #StyleiqFeatured-{{ section.id }} {
      padding-top: 55px;
      padding-bottom: 55px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-container {
      width: calc(100% - 32px);
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-header {
      margin-bottom: 24px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-eyebrow {
      margin-bottom: 11px;
      font-size: 9px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-heading h2 {
      font-size: clamp(32px, 9vw, 44px);
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-heading p {
      margin-top: 12px;
      font-size: 12px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-products:not(.is-slider) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px 12px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-products.is-slider {
      gap: 12px;
    }

    #StyleiqFeatured-{{ section.id }} .is-slider .siq-featured-product {
      flex-basis: calc((100% - 12px) / 2);
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-arrow {
      width: 36px;
      height: 36px;
      font-size: 18px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-view-all {
      font-size: 9px;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-empty {
      padding: 48px 18px;
    }
  }

  @media (max-width: 360px) {
    #StyleiqFeatured-{{ section.id }} .is-slider .siq-featured-product {
      flex-basis: 78%;
    }
  }

  /* ACCESSIBILITY */

  #StyleiqFeatured-{{ section.id }} button:focus-visible,
  #StyleiqFeatured-{{ section.id }} a:focus-visible {
    outline: 2px solid var(--siq-gold);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    #StyleiqFeatured-{{ section.id }} .siq-featured-products.is-slider {
      scroll-behavior: auto;
    }

    #StyleiqFeatured-{{ section.id }} .siq-featured-arrow,
    #StyleiqFeatured-{{ section.id }} .siq-featured-view-all {
      transition: none;
    }
  }
{% endstyle %}

<script>
(function () {
  const sectionId = 'StyleiqFeatured-{{ section.id }}';
  const namespace = '__siqFeaturedSliderCleanup';

  function initializeFeaturedSlider() {
    const root = document.getElementById(sectionId);
    if (!root) return;

    const track = root.querySelector('[data-featured-track]');
    const previous = root.querySelector('[data-featured-prev]');
    const next = root.querySelector('[data-featured-next]');

    if (!track || !previous || !next) return;

    if (track.dataset.sliderInitialized === 'true') return;
    track.dataset.sliderInitialized = 'true';

    const cleanups = [];
    let resizeObserver = null;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    function listen(element, event, callback, options) {
      element.addEventListener(event, callback, options);

      cleanups.push(function () {
        element.removeEventListener(event, callback, options);
      });
    }

    function getScrollDistance() {
      const card = track.querySelector('[data-featured-card]');
      if (!card) return track.clientWidth;

      const gap = parseFloat(
        window.getComputedStyle(track).columnGap
      ) || 0;

      return card.getBoundingClientRect().width + gap;
    }

    function updateArrows() {
      const maxScroll = Math.max(
        0,
        track.scrollWidth - track.clientWidth
      );

      previous.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= maxScroll - 2;

      const canScroll = maxScroll > 2;

      previous.setAttribute(
        'aria-disabled',
        String(!canScroll || previous.disabled)
      );

      next.setAttribute(
        'aria-disabled',
        String(!canScroll || next.disabled)
      );
    }

    function scrollTrack(direction) {
      track.scrollBy({
        left: direction * getScrollDistance(),
        behavior: reducedMotion.matches ? 'auto' : 'smooth'
      });
    }

    listen(previous, 'click', function () {
      scrollTrack(-1);
    });

    listen(next, 'click', function () {
      scrollTrack(1);
    });

    listen(track, 'scroll', updateArrows, {
      passive: true
    });

    if ('ResizeObserver' in window) {
      resizeObserver = new ResizeObserver(updateArrows);
      resizeObserver.observe(track);

      const cards = track.querySelectorAll('[data-featured-card]');
      cards.forEach(function (card) {
        resizeObserver.observe(card);
      });
    } else {
      listen(window, 'resize', updateArrows);
    }

    if (typeof window[namespace] !== 'function') {
      window[namespace] = {};
    }

    window[namespace][sectionId] = function () {
      cleanups.forEach(function (cleanup) {
        cleanup();
      });

      if (resizeObserver) {
        resizeObserver.disconnect();
      }

      delete track.dataset.sliderInitialized;
      delete window[namespace][sectionId];
    };

    requestAnimationFrame(updateArrows);
  }

  function cleanupFeaturedSlider() {
    const cleanupRegistry = window[namespace];

    if (
      cleanupRegistry &&
      typeof cleanupRegistry[sectionId] === 'function'
    ) {
      cleanupRegistry[sectionId]();
    }
  }

  function initialize() {
    initializeFeaturedSlider();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialize, {
      once: true
    });
  } else {
    initialize();
  }

  document.addEventListener('shopify:section:load', function (event) {
    if (
      event.detail &&
      event.detail.sectionId === '{{ section.id }}'
    ) {
      initialize();
    }
  });

  document.addEventListener('shopify:section:unload', function (event) {
    if (
      event.detail &&
      event.detail.sectionId === '{{ section.id }}'
    ) {
      cleanupFeaturedSlider();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE LATEST EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "The pieces you will keep."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Considered essentials, effortless silhouettes, and pieces made for everyday style."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Featured collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable horizontal product slider",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F6F1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
