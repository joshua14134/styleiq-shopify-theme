<section class="siq-gallery section-pad" data-siq-gallery>
  <div class="page-width"><div class="siq-section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p></div><div class="siq-gallery-controls"><button type="button" class="siq-arrow" data-gallery-prev aria-label="Previous gallery item">←</button><button type="button" class="siq-arrow" data-gallery-next aria-label="Next gallery item">→</button></div></div>
  {% assign gallery_collection = section.settings.collection %}<div class="siq-gallery-viewport"><div class="siq-gallery-track" data-gallery-track>
    {% if gallery_collection != blank and gallery_collection.products_count > 0 %}{% for product in gallery_collection.products limit: section.settings.limit %}<article class="siq-gallery-card"><a href="{{ product.url }}" class="siq-gallery-image">{% render 'product-image', product: product %}<span class="siq-gallery-number">{{ forloop.index | prepend: '0' }}</span><span class="siq-gallery-view">View piece ↗</span></a><div class="siq-gallery-meta"><div><a href="{{ product.url }}">{{ product.title | escape }}</a><small>{{ product.type | default: 'STYLEIQ EDIT' | escape }}</small></div><strong>{{ product.price | money }}</strong></div></article>{% endfor %}{% else %}<div class="siq-empty">Choose a collection in Customize to show products in this gallery.</div>{% endif %}
  </div></div><div class="siq-gallery-progress"><span data-gallery-progress></span></div></div>
</section>
{% schema %}{"name":"Animated gallery","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A CLOSER LOOK"},{"type":"text","id":"heading","label":"Heading","default":"Pieces worth a second look."},{"type":"text","id":"copy","label":"Description","default":"Explore the details, textures and silhouettes in our latest edit."},{"type":"collection","id":"collection","label":"Product collection"},{"type":"range","id":"limit","min":4,"max":12,"step":1,"label":"Products to show","default":8}],"presets":[{"name":"Animated gallery"}]}{% endschema %}