<section class="ai-banner"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}<br><em>{{ section.settings.italic_heading | escape }}</em></h2><p>{{ section.settings.copy | escape }}</p><a class="button button-light" href="{{ section.settings.link }}">Find my look →</a></div>{% if section.settings.image %}{{ section.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', alt: section.settings.heading }}{% endif %}</section>
{% schema %}{"name":"AI stylist banner","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STYLE, WITH INTELLIGENCE"},{"type":"text","id":"heading","label":"Heading","default":"Meet your"},{"type":"text","id":"italic_heading","label":"Italic heading","default":"personal stylist."},{"type":"textarea","id":"copy","label":"Copy","default":"Tell us the occasion, your budget, and the way you like to dress. We'll help you build a look."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"AI stylist banner"}]}{% endschema %}