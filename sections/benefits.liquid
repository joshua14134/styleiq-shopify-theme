<section class="benefits">{% for block in section.blocks %}<div class="benefit" {{ block.shopify_attributes }}><span class="benefit-icon">{{ block.settings.icon }}</span><span><b>{{ block.settings.title | escape }}</b><small>{{ block.settings.copy | escape }}</small></span></div>{% endfor %}</section>
{% schema %}{"name":"Store benefits","blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon or symbol","default":"✧"},{"type":"text","id":"title","label":"Title","default":"Considered essentials"},{"type":"text","id":"copy","label":"Copy","default":"Designed for repeat wear"}]}],"presets":[{"name":"Store benefits","blocks":[{"type":"benefit","settings":{"icon":"↗","title":"Complimentary shipping","copy":"On orders above ₹2,500"}},{"type":"benefit","settings":{"icon":"↺","title":"Easy returns","copy":"See our returns policy"}},{"type":"benefit","settings":{"icon":"◇","title":"Secure checkout","copy":"Powered by Shopify"}},{"type":"benefit","settings":{"icon":"✦","title":"AI personal stylist","copy":"Find your perfect look"}}]}]}{% endschema %}