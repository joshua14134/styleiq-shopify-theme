<section class="section cart-page"><div class="page-heading"><span class="eyebrow">YOUR SELECTION</span><h1>The bag.</h1><p>{{ cart.item_count }} pieces, considered.</p></div>{% if cart.item_count == 0 %}<div class="empty-state"><h2>Your bag is taking a break.</h2><p>Find something that feels like you.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Explore the collection →</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" id="CartForm"><div class="cart-layout"><div>{% for item in cart.items %}<article class="cart-item"><a href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: alt: item.product.title }}</a><div><a class="product-name" href="{{ item.url }}">{{ item.product.title | escape }}</a><small>{{ item.variant.title | escape }}</small><b>{{ item.final_price | money }}</b><label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label><a class="clear-link" href="{{ item.url_to_remove }}">Remove</a></div></article>{% endfor %}<button class="button button-outline" type="submit" name="update">Update bag</button></div><aside class="order-summary"><h2>Order summary</h2><p><span>Subtotal</span><b>{{ cart.total_price | money }}</b></p><small>Shipping and discounts are calculated at checkout.</small><button class="button button-dark full-button" type="submit" name="checkout">Proceed to checkout →</button><a class="text-link" href="{{ routes.all_products_collection_url }}">Continue shopping</a></aside></div></form>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]} {% endschema %}