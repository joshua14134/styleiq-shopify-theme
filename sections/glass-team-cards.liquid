<section class="siq-moods section-pad"><div class="page-width"><div class="siq-section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p></div></div><div class="siq-mood-grid">
{% for block in section.blocks %}<a class="siq-mood-card" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}><div class="siq-mood-image">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: block.settings.title }}{% else %}<div class="siq-mood-placeholder"><span>{{ block.settings.number | escape }}</span></div>{% endif %}<span class="siq-glass-arrow">↗</span></div><div class="siq-mood-info"><span>{{ block.settings.kicker | escape }}</span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p></div></a>{% endfor %}
</div></div></section>
{% schema %}{"name":"Glass style cards","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"STYLE, IN YOUR ELEMENT"},{"type":"text","id":"heading","label":"Heading","default":"Find your fashion mood."},{"type":"text","id":"copy","label":"Description","default":"Different moods. One considered wardrobe."}],"blocks":[{"type":"mood","name":"Style mood","settings":[{"type":"text","id":"number","label":"Fallback number","default":"01"},{"type":"text","id":"kicker","label":"Kicker","default":"THE EVERYDAY EDIT"},{"type":"text","id":"title","label":"Title","default":"Quiet essentials"},{"type":"text","id":"copy","label":"Description","default":"Clean lines and easy layers."},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":4,"presets":[{"name":"Glass style cards","blocks":[{"type":"mood","settings":{"number":"01","kicker":"THE EVERYDAY EDIT","title":"Quiet essentials","copy":"Clean lines and easy layers.","link":"/collections/all"}},{"type":"mood","settings":{"number":"02","kicker":"THE AFTER-HOURS EDIT","title":"Evening mood","copy":"A little drama, beautifully done.","link":"/collections/women"}},{"type":"mood","settings":{"number":"03","kicker":"THE MODERN CLASSIC","title":"Tailored ease","copy":"Sharp silhouettes, soft attitude.","link":"/collections/men"}}]}]}{% endschema %}