<section class="section"><div class="page-heading"><span class="eyebrow">FIND YOUR NEXT FAVOURITE</span><h1>Search STYLEIQ.</h1></div><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products, styles, and more"><input type="hidden" name="options[prefix]" value="last"><button class="button button-dark" type="submit">Search →</button></form>{% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<a href="{{ item.url }}">{{ item.title | escape }}</a>{% endif %}{% endfor %}</div>{% endif %}</section>{% schema %}{"name":"Main search","settings":[]} {% endschema %}