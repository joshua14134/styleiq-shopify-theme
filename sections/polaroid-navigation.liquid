<section class="siq-polaroids section-pad"><div class="page-width"><div class="siq-section-heading"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2><p>{{ section.settings.copy | escape }}</p></div></div><nav class="siq-polaroid-nav" aria-label="Shop by collection">{% for block in section.blocks %}<a class="siq-polaroid" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}><span class="siq-polaroid-photo">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '280, 420, 700', alt: block.settings.title }}{% else %}{% assign card_title = block.settings.title | downcase %}{% assign card_asset = '08_coord_set.jpg' %}{% if card_title contains 'men' %}{% assign card_asset = '05_denim_jacket.jpg' %}{% elsif card_title contains 'women' %}{% assign card_asset = '11_cropped_blazer.jpg' %}{% elsif card_title contains 'accessor' %}{% assign card_asset = '12_structured_handbag.jpg' %}{% elsif card_title contains 'new' %}{% assign card_asset = '07_satin_midi_dress.jpg' %}{% endif %}<img src="{{ card_asset | asset_url }}" alt="{{ block.settings.title | escape }} collection" loading="lazy" width="700" height="875">{% endif %}</span><span class="siq-polaroid-caption"><strong>{{ block.settings.title | escape }}</strong><small>{{ block.settings.subtitle | escape }}</small></span><span class="siq-polaroid-arrow" aria-hidden="true">↗</span></a>{% endfor %}</nav></div></section>
{% schema %}{"name":"Polaroid collection nav","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"YOUR NEXT FAVOURITE"},{"type":"text","id":"heading","label":"Heading","default":"Shop by your own rules."},{"type":"text","id":"copy","label":"Description","default":"A playful way into the STYLEIQ wardrobe."}],"blocks":[{"type":"collection_link","name":"Collection link","settings":[{"type":"text","id":"monogram","label":"Fallback monogram","default":"S."},{"type":"text","id":"title","label":"Title","default":"New arrivals"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Fresh perspective"},{"type":"image_picker","id":"image","label":"Image"},{"type":"url","id":"link","label":"Link"}]}],"max_blocks":4,"presets":[{"name":"Polaroid collection nav","blocks":[{"type":"collection_link","settings":{"monogram":"01","title":"New arrivals","subtitle":"Fresh perspective","link":"/collections/all"}},{"type":"collection_link","settings":{"monogram":"02","title":"Men's wear","subtitle":"Modern essentials","link":"/collections/men"}},{"type":"collection_link","settings":{"monogram":"03","title":"Women's wear","subtitle":"A softer statement","link":"/collections/women"}},{"type":"collection_link","settings":{"monogram":"04","title":"Accessories","subtitle":"Finish the look","link":"/collections/accessories"}}]}]}{% endschema %}