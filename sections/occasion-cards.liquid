<section class="section"><div class="section-head"><div><span class="eyebrow">{{ section.settings.eyebrow | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="occasion-grid">{% for block in section.blocks %}<a class="occasion-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}{% assign occasion_title = block.settings.title | downcase %}{% assign occasion_asset = '02_oversized_tee.jpg' %}{% if occasion_title contains 'work' %}{% assign occasion_asset = '04_linen_blazer.jpg' %}{% elsif occasion_title contains 'date' %}{% assign occasion_asset = '07_satin_midi_dress.jpg' %}{% elsif occasion_title contains 'weekend' %}{% assign occasion_asset = '05_denim_jacket.jpg' %}{% endif %}<img src="{{ occasion_asset | asset_url }}" alt="{{ block.settings.title | escape }} style" loading="lazy" width="900" height="1125">{% endif %}<span class="occasion-overlay"></span><span class="occasion-copy"><b>{{ block.settings.title | escape }}</b><small>{{ block.settings.copy | escape }}</small><i>Explore ↗</i></span></a>{% endfor %}</div></section>
{% schema %}{"name":"Shop by occasion","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"DRESS FOR THE MOMENT"},{"type":"text","id":"heading","label":"Heading","default":"Shop by occasion."}],"blocks":[{"type":"occasion","name":"Occasion","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Everyday"},{"type":"text","id":"copy","label":"Description","default":"Easy, considered layers"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Shop by occasion","blocks":[{"type":"occasion"},{"type":"occasion","settings":{"title":"Workwear","copy":"A sharper point of view"}},{"type":"occasion","settings":{"title":"Date night","copy":"Make an entrance"}},{"type":"occasion","settings":{"title":"Weekend","copy":"Off-duty, on point"}}]}]}{% endschema %}